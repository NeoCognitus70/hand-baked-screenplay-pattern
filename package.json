{
  "name": "hand-baked-screenplay-pattern",
  "version": "0.3.0",
  "description": "A hand-baked, dependency-free TypeScript implementation of the Screenplay Pattern, following the design model and naming conventions popularised by Serenity/JS (but independent of it).",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeoCognitus70/hand-baked-screenplay-pattern.git"
  },
  "homepage": "https://github.com/NeoCognitus70/hand-baked-screenplay-pattern#readme",
  "bugs": {
    "url": "https://github.com/NeoCognitus70/hand-baked-screenplay-pattern/issues"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/write-cjs-package.mjs",
    "build": "npm run clean && npm run build:esm && npm run build:cjs",
    "typecheck": "tsc -p tsconfig.spec.json",
    "test": "vitest run",
    "test:package": "node scripts/test-packed-package.mjs",
    "coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run build && npm test && npm run test:package",
    "report:sample": "npm run build && node scripts/generate-sample-report.mjs",
    "test:watch": "vitest",
    "prepack": "npm run verify",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "screenplay",
    "screenplay-pattern",
    "bdd",
    "test-automation",
    "actors",
    "typescript"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
