{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing. Visibility only, no hard gate -- the same stance the coverage config takes (HBSP-12). `thresholds.break` is null so a low score reports but never fails a build; raise it deliberately once the score is understood and stable.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": [
    "html",
    "json",
    "clear-text",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts",
    "!src/**/index.ts",
    "!src/sample/**"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  }
}
